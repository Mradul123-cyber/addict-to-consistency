rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Usage/quota docs — read allowed, but writes must only increment (never reset)
      match /usage/{usageDoc} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && (!("pdfUploadsUsed" in request.resource.data)
              || (resource == null ? request.resource.data.pdfUploadsUsed >= 0
                  : request.resource.data.pdfUploadsUsed >= resource.data.get("pdfUploadsUsed", 0)))
          && (!("imageUploadsUsed" in request.resource.data)
              || (resource == null ? request.resource.data.imageUploadsUsed >= 0
                  : request.resource.data.imageUploadsUsed >= resource.data.get("imageUploadsUsed", 0)))
          && (!("promptCount" in request.resource.data)
              || (resource == null ? request.resource.data.promptCount >= 0
                  : request.resource.data.promptCount >= resource.data.get("promptCount", 0)));
      }
    }

    // Public question bank (read by all authenticated users, write by admin only)
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == "1tPxrTKc0ZXFhRb0ZngWjp75zJ32";
    }

    // Device abuse prevention — track which accounts used AI per device
    match /deviceAccounts/{deviceId} {
      // Only readable if: document doesn't exist yet (new device check) OR caller's UID is already registered
      // Permission-denied on an existing doc = UID not registered = device full → client treats as blocked
      allow read: if request.auth != null
        && (resource == null || resource.data.uids.hasAll([request.auth.uid]));

      // Only allow adding own UID — existing UIDs can never be removed
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(["uids"])
        && request.resource.data.uids is list
        && request.resource.data.uids.hasAll([request.auth.uid])
        && (resource == null || request.resource.data.uids.hasAll(resource.data.uids));
    }

    // Community notes — any authenticated user can upload and upvote
    match /communityNotes/{noteId} {
      // All notes publicly visible to authenticated users
      allow read: if request.auth != null;
      // Creator must set uploadedBy to their own UID and status must start as unverified
      allow create: if request.auth != null
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.status == "unverified";
      // Non-admins can only update upvotes — status change is admin-only
      allow update: if request.auth != null
        && (request.auth.uid == "1tPxrTKc0ZXFhRb0ZngWjp75zJ32"
            || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["upvotes"]));
      allow delete: if request.auth != null
        && (request.auth.uid == "1tPxrTKc0ZXFhRb0ZngWjp75zJ32"
            || resource.data.uploadedBy == request.auth.uid);
    }
  }
}