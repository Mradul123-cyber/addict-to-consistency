{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "jee-airgap-shield@self-hosted",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "name": "AirGap Shield",
  "version": "1.0.1",
  "description": "Blocks distracting sites so you can stay focused on what matters. Controlled from the Matrix Console.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs",
    "alarms",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "https://addict-to-consistency.lovable.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "blocked.html"
  ],
  "browser_action": {
    "default_title": "AirGap Shield"
  }
}
