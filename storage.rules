rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /notes/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /content-uploads/{allPaths=**} {
      // Only the admin UID can upload/read content PDFs
      allow read, write: if request.auth != null
        && request.auth.uid == "1tPxrTKc0ZXFhRb0ZngWjp75zJ32";
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
